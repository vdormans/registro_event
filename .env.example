# ─── BASE DE DATOS ───────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/registro_eventos"

# ─── JWT ─────────────────────────────────────────────────────────
JWT_SECRET="cambia_este_secreto_por_uno_seguro_en_produccion"
JWT_REFRESH_SECRET="cambia_este_refresh_secreto_por_uno_seguro"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── SERVIDOR ────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"

# ─── FRONTEND ────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ─── BCRYPT ──────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── ALMACENAMIENTO ──────────────────────────────────────────────
STORAGE_PROVIDER="local"
UPLOAD_DIR="uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─── ADMIN INICIAL (seed) ────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@empresa.com"
SEED_ADMIN_PASSWORD="Admin1234!"
SEED_ADMIN_NOMBRE="Administrador Principal"
